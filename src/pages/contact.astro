---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import Field from "../components/Field.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import { SITE, CONTACT } from "../consts";
import wechatQr from "../assets/images/contact/wechat-qr.webp";
import whatsappQr from "../assets/images/contact/whatsapp-qr.webp";

const contactPoints = [
  { icon: "mail", label: "Email", value: CONTACT.email },
  { icon: "whatsapp", label: "WhatsApp", value: CONTACT.whatsapp, href: "https://wa.me/8617335791762" },
  { icon: "pin", label: "Address", value: `${CONTACT.addressLine1}, ${CONTACT.addressLine2}` },
];
---
<BaseLayout
  title="Contact"
  description="Contact ZD Mining for product information, project questions and export quotations."
>
  <PageHero
    tone="dark"
    eyebrow="Contact us"
    title="Contact us"
    intro="Tell us what you are looking for, and our team will help you identify the right product and next steps."
    crumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]}
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-5">
      {/* Contact info */}
      <div class="order-2 lg:order-1 lg:col-span-2">
        <span class="eyebrow">Get in touch</span>
        <h2 class="mt-3">More ways to contact us</h2>
        <p class="mt-3 text-carbon-500">Choose the contact method that works best for you, or send us a message and our team will reply.</p>
        <ul class="mt-8 space-y-5">
          {contactPoints.map((c) => (
            <li class="flex gap-4">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-sm bg-brand-50 text-brand-600">
                <Icon name={c.icon} class="size-5" />
              </span>
              <div>
                <p class="text-sm font-700 text-carbon-800">{c.label}</p>
                {c.href ? (
                  <a href={c.href} target="_blank" rel="noopener noreferrer" class="font-700 text-accent-700 underline decoration-accent-300 underline-offset-4 transition hover:text-brand-600 hover:decoration-brand-600">{c.value}</a>
                ) : (
                  c.label === "Email" ? (
                    <a href={`mailto:${c.value}`} class="font-700 text-accent-700 underline decoration-accent-300 underline-offset-4 transition hover:text-brand-600 hover:decoration-brand-600">{c.value}</a>
                  ) : (
                    <p class="text-carbon-500">{c.value}</p>
                  )
                )}
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex max-w-max flex-wrap gap-3">
          <div class="w-[9.25rem] rounded-md border border-carbon-100 bg-white p-2.5 text-center shadow-sm">
            <OptimizedImage src={whatsappQr} alt="ZD Mining WhatsApp contact QR code" class="mx-auto aspect-square w-full max-w-[6.5rem] object-contain" loading="eager" widths={[160, 240]} sizes="9.25rem" />
            <p class="mt-3 text-sm font-700 text-brand-700">WhatsApp</p>
          </div>
          <div class="w-[9.25rem] rounded-md border border-carbon-100 bg-white p-2.5 text-center shadow-sm">
            <OptimizedImage src={wechatQr} alt="ZD Mining WeChat contact QR code" class="mx-auto aspect-square w-full max-w-[6.5rem] object-contain" loading="eager" widths={[160, 240]} sizes="9.25rem" />
            <p class="mt-3 text-sm font-700 text-brand-700">WeChat</p>
          </div>
        </div>
        <p class="mt-4 text-xs text-carbon-400">{CONTACT.hours} (GMT+8)</p>
      </div>

      {/* Form */}
      <div class="order-1 lg:order-2 lg:col-span-3">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="rounded-md border border-carbon-200 bg-carbon-100 p-6 shadow-[0_18px_50px_-32px_rgba(5,42,104,0.35)] sm:p-8"
        >
          {/* Web3Forms config */}
          <input type="hidden" name="access_key" value={SITE.web3formsKey} />
          <input type="hidden" name="subject" value="New inquiry from ZD Mining website" />
          <input type="hidden" name="from_name" value="ZD Mining Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          {/* Redirect fallback (non-JS) after success */}
          <input type="hidden" name="redirect" value={`${SITE.url}/thank-you`} />

          <h2 class="!text-xl">Request a quote</h2>
          <p class="mt-1 text-sm text-carbon-500">Fields marked * are required.</p>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <Field label="Name" name="name" />
            <Field label="Email *" name="email" type="email" required />
          </div>

          <div class="mt-5">
            <Field label="Phone / WhatsApp" name="phone" type="tel" />
          </div>

          <div class="mt-5">
            <label class="mb-1.5 block text-sm font-700 text-carbon-700">Message *</label>
            <textarea
              name="message"
              required
              rows="5"
              class="w-full rounded-xs border border-carbon-200 bg-white px-3.5 py-2.5 text-base outline-none transition focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary mt-6 w-full text-base">
            Send inquiry <Icon name="arrowRight" class="size-4" />
          </button>

          <p id="form-status" class="mt-4 hidden rounded-xs border p-4 text-sm" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // AJAX submission for the Web3Forms contact form.
  import { appendSubmissionMeta } from "../scripts/form-meta";
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = "Sending…";

      try {
        const body = new FormData(form);
        await appendSubmissionMeta(body);
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body,
        });
        const data = await res.json();

        if (data.success) {
          form.reset();

          // Conversion tracking: redirect to the thank-you page.
          window.location.assign("/thank-you/");
        } else {
          throw new Error(data.message || "Submission failed");
        }
      } catch (err) {
        if (status) {
          status.className =
            "mt-4 block rounded-xs border border-cat-red/30 bg-cat-red/10 p-4 text-sm text-cat-red";
          status.innerHTML =
            "Something went wrong. Please email us directly at info@miningzd.com or try again.";
        }
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  }
</script>
