---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import ContactForm from "../../components/ContactForm.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import ballMillImg from "../../assets/images/gold-ore-ball-mill/gold-ore-ball-mill-wide-hero.webp";
import ballMillPlantImg from "../../assets/images/gold-ore-ball-mill/ball-mill-inside-mining-plant.webp";
import ballMillCutawayImg from "../../assets/images/gold-ore-ball-mill/ball-mill-cutaway-working-principle.webp";
import wetPanImg from "../../assets/images/wet-pan-mill-for-gold/gold-wet-pan-mill-wide-hero.webp";
import steelBallsImg from "../../assets/images/forged-grinding-steel-balls/forged-steel-grinding-balls.webp";
import { generateProductSchema, generateBreadcrumbSchema } from "../../config/seo";
import { SITE } from "../../config/site";

export const getStaticPaths = (async () => {
  const products = await getCollection("products");
  return products.map((p) => ({
    params: { slug: p.id },
    props: { product: p },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { Content } = await render(product);

// Related products: same category, or fall back to others
const all = (await getCollection("products")).filter((p) => p.id !== product.id);
const related = [
  ...all.filter((p) => p.data.category === product.data.category),
  ...all.filter((p) => p.data.category !== product.data.category),
].slice(0, 3);

const d = product.data;
const isBallMill = product.id === "gold-ore-ball-mill";
const heroDescriptions: Record<string, string> = {
  "gold-ore-ball-mill": "GoldCore supplies wet and dry ball mills for gold ore, copper ore and hard-rock mineral processing. Share your feed size, required capacity and recovery route to receive a matched configuration and quotation.",
  "wet-pan-mill-for-gold": "GoldCore supplies wet pan mills for small-scale gold mining, hard-rock gold processing and gravity recovery applications. Send your feed size and target capacity for a matched model and export quotation.",
  "forged-grinding-steel-balls": "GoldCore supplies forged grinding steel balls for gold, copper and mineral processing ball mills. Tell us your mill size, ball diameter and required grade for a matched quotation and delivery plan.",
};
const heroDescription = heroDescriptions[product.id] ?? d.description;
const ballMillModels = [
  { model: "900×1800", feed: "≤20", discharge: "0.075–0.89", capacity: "0.65–2", power: "18.5", weight: "5.8" },
  { model: "900×3000", feed: "≤20", discharge: "0.075–0.89", capacity: "1.1–3.5", power: "22", weight: "6.8" },
  { model: "1200×2400", feed: "≤25", discharge: "0.075–0.60", capacity: "1.5–4.8", power: "30", weight: "12" },
  { model: "1200×3000", feed: "≤25", discharge: "0.074–0.40", capacity: "1.6–5", power: "37", weight: "13.2" },
  { model: "1200×4500", feed: "≤25", discharge: "0.074–0.40", capacity: "1.6–5.8", power: "55", weight: "13.7" },
  { model: "1500×3000", feed: "≤25", discharge: "0.074–0.40", capacity: "2–5", power: "75", weight: "16.5" },
  { model: "1500×4500", feed: "≤25", discharge: "0.074–0.40", capacity: "3–6", power: "110", weight: "21" },
  { model: "1830×3000", feed: "≤25", discharge: "0.074–0.40", capacity: "4–10", power: "130", weight: "34.5" },
  { model: "1830×4500", feed: "≤25", discharge: "0.074–0.40", capacity: "4.5–12", power: "155", weight: "38" },
];

const productImages: Record<string, ImageMetadata> = {
  "gold-ore-ball-mill": ballMillImg,
  "wet-pan-mill-for-gold": wetPanImg,
  "forged-grinding-steel-balls": steelBallsImg,
};
const heroImage = productImages[product.id];
const heroImageAlt = d.heroImageAlt || d.title;

// Generate Product Schema
const schemaImage = new URL(heroImage.src, SITE.url).href;
const contactAction = `openContactModal(${JSON.stringify({ sourcePage: `/products/${product.id}`, productInterest: d.title, ctaLabel: "Request a Quote" })})`;

const productSchema = generateProductSchema({
  name: d.title,
  description: d.description,
  image: schemaImage,
  url: new URL(`/products/${product.id}`, SITE.url).href,
});

// Generate Breadcrumb Schema
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", url: SITE.url },
  { name: "Products", url: new URL("/products", SITE.url).href },
  { name: d.title, url: new URL(`/products/${product.id}`, SITE.url).href },
]);

// Combine schemas
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [productSchema, breadcrumbSchema],
};
---
<BaseLayout title={d.title} description={d.description} image={heroImage.src} type="website" jsonLd={jsonLd}>
  {/* ============================= BUYER-LED HERO */}
  <section class="relative overflow-hidden bg-carbon-950 text-white">
    <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-brand-700/20 lg:block"></div>
    <div class="container-x relative py-12 sm:py-16 lg:pr-0 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 min-w-0">
        <ol class="flex min-w-0 items-center gap-2 text-sm text-white/55">
          <li class="shrink-0"><a href="/" class="transition hover:text-accent-300">Home</a></li>
          <li class="shrink-0"><Icon name="chevronRight" class="size-3.5 opacity-50" /></li>
          <li class="shrink-0"><a href="/products" class="transition hover:text-accent-300">Products</a></li>
          <li class="shrink-0"><Icon name="chevronRight" class="size-3.5 opacity-50" /></li>
          <li class="min-w-0 flex-1"><span class="block truncate text-white/85">{d.title}</span></li>
        </ol>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-12">
        <div class="min-w-0">
          <h1 class="max-w-3xl !text-white">{d.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/72">{heroDescription}</p>

          <ul class="mt-7 space-y-3">
            {d.features.slice(0, 4).map((feature) => (
              <li class="flex items-start gap-2 text-sm text-white/82"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-400" />{feature}</li>
            ))}
          </ul>

          <div class="mt-8">
            <button class="btn btn-primary" onclick={contactAction}>Request a Quote <Icon name="arrowRight" class="size-[1.15em]" /></button>
          </div>
        </div>

        <div class="relative lg:-mr-[max(0px,calc((100vw-80rem)/2))] lg:ml-8 lg:pl-4">
          <div class="relative overflow-hidden border border-white/15 bg-carbon-900 shadow-2xl">
            <OptimizedImage src={heroImage} alt={heroImageAlt} class="aspect-[16/10] w-full object-cover" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {isBallMill && (
    <>
      {/* ============================= BALL MILL INTRO */}
      <Section>
        <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div>
            <p class="eyebrow">Gold ore grinding, made selectable</p>
            <h2 class="mt-3">A ball mill is not selected by diameter alone.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-carbon-600">The mill has to match the ore, the target liberation size, the slurry route and the way the downstream circuit will classify and recover the valuable mineral. This page is designed to help you make that decision before you request a quotation.</p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="border-l-2 border-accent-500 pl-4"><p class="font-700 text-brand-700">Wet or dry grinding</p><p class="mt-1 text-sm text-carbon-500">Choose the route around moisture, dust control and recovery circuit requirements.</p></div>
              <div class="border-l-2 border-accent-500 pl-4"><p class="font-700 text-brand-700">Overflow or grate discharge</p><p class="mt-1 text-sm text-carbon-500">Match discharge behavior to target fineness, slurry flow and required throughput.</p></div>
            </div>
          </div>
          <figure class="overflow-hidden border border-carbon-200 bg-carbon-50">
            <OptimizedImage src={ballMillPlantImg} alt="Ball mill operating inside a mineral processing plant" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <figcaption class="px-4 py-3 text-xs leading-relaxed text-carbon-500">Reference image: ball mill inside the Mayflower Mill, Wikimedia Commons, CC BY-SA 3.0.</figcaption>
          </figure>
        </div>
      </Section>

      {/* ============================= CIRCUIT LOGIC */}
      <Section tone="dark" eyebrow="How the grinding circuit works" title="From crushed ore to a controllable recovery feed">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <figure class="overflow-hidden border border-white/10 bg-white p-3">
            <OptimizedImage src={ballMillCutawayImg} alt="Cutaway diagram showing grinding media and ore movement inside a ball mill" class="aspect-[4/3] w-full object-contain" loading="lazy" />
            <figcaption class="px-2 py-3 text-xs leading-relaxed text-carbon-500">Working-principle reference diagram from Wikimedia Commons, public-domain source.</figcaption>
          </figure>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              ["01", "Feed", "Crushed ore enters through the feed spout at a controlled rate."],
              ["02", "Impact + attrition", "The rotating shell lifts and drops the grinding media through the ore charge."],
              ["03", "Slurry or product", "Wet grinding carries fine particles away in slurry; dry grinding discharges powder."],
              ["04", "Classification", "A screen, spiral classifier or hydrocyclone controls the material returning to the mill."],
            ].map(([number, title, text]) => (
              <div class="border border-white/10 bg-white/5 p-5">
                <span class="font-display text-sm font-800 tracking-[0.2em] text-accent-400">{number}</span>
                <h3 class="mt-3 !text-lg !text-white">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-white/65">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </Section>

      {/* ============================= TYPES */}
      <Section eyebrow="Configuration choices" title="Choose the mill around the process, not the other way around">
        <div class="grid gap-5 md:grid-cols-3">
          {[
            ["Wet grinding", "For slurry circuits feeding gravity concentration, flotation or leaching. Water helps transport fines and suppresses dust, but the drainage and pump route must be planned."],
            ["Dry grinding", "For operations that need a dry powder product or have limited process water. Dust collection, feed moisture and downstream handling become key design inputs."],
            ["Discharge design", "Overflow discharge suits controlled fine grinding; grate discharge supports faster slurry removal when higher throughput is the priority."],
          ].map(([title, text]) => (
            <div class="card p-7">
              <span class="block h-1 w-12 bg-accent-500"></span>
              <h3 class="mt-6 !text-xl">{title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-carbon-600">{text}</p>
            </div>
          ))}
        </div>
      </Section>

      {/* ============================= MODEL TABLE */}
      <Section id="technical-data" tone="alt" eyebrow="Reference sizing" title="Ball mill models for preliminary selection" intro="The table below is a starting range for discussion, not a guaranteed production schedule. Final capacity depends on ore hardness, feed distribution, target P80, circulating load and operating conditions.">
        <div class="overflow-x-auto border border-carbon-200 bg-white">
          <table class="w-full min-w-[60rem] text-left text-sm">
            <thead class="bg-brand-700 text-xs uppercase tracking-wider text-white">
              <tr>
                <th class="px-5 py-4 font-700">Model</th>
                <th class="px-5 py-4 font-700">Feed ≤ mm</th>
                <th class="px-5 py-4 font-700">Discharge mm</th>
                <th class="px-5 py-4 font-700">Capacity t/h</th>
                <th class="px-5 py-4 font-700">Motor kW</th>
                <th class="px-5 py-4 font-700">Weight t</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-carbon-100">
              {ballMillModels.map((row, index) => (
                <tr class={index % 2 ? "bg-carbon-50/70" : "bg-white"}>
                  <th class="px-5 py-3.5 font-700 text-brand-700">Φ{row.model}</th>
                  <td class="px-5 py-3.5 text-carbon-600">{row.feed}</td>
                  <td class="px-5 py-3.5 text-carbon-600">{row.discharge}</td>
                  <td class="px-5 py-3.5 font-700 text-carbon-800">{row.capacity}</td>
                  <td class="px-5 py-3.5 text-carbon-600">{row.power}</td>
                  <td class="px-5 py-3.5 text-carbon-600">{row.weight}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-carbon-500">Reference ranges synthesized from publicly available ball mill tables published by HXJQ and Hengxing Machinery. Confirm the final model, capacity and power against your ore test data before purchase.</p>
      </Section>
    </>
  )}

  {/* ============================= PRODUCT SNAPSHOT */}
  <section class="border-b border-carbon-100 bg-white">
    <div class="container-x grid gap-px overflow-hidden rounded-md border border-carbon-100 bg-carbon-100 sm:grid-cols-3">
      <div class="bg-white px-6 py-6 sm:px-8">
        <p class="eyebrow">Product category</p>
        <p class="mt-2 text-lg font-700 text-brand-700">{d.category}</p>
      </div>
      <div class="bg-white px-6 py-6 sm:px-8">
        <p class="eyebrow">Typical fit</p>
        <p class="mt-2 text-lg font-700 text-brand-700">{d.applications[0]}</p>
      </div>
      <div class="bg-white px-6 py-6 sm:px-8">
        <p class="eyebrow">Selection support</p>
        <p class="mt-2 text-lg font-700 text-brand-700">Application-matched proposal</p>
      </div>
    </div>
  </section>

  {/* ============================= VALUE PROPOSITION */}
  <Section eyebrow="Why this product" title={`Built around the conditions that matter for ${d.title}`}>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {d.features.map((feature, index) => (
        <div class="card group p-6 transition hover:-translate-y-1 hover:shadow-[0_18px_40px_-24px_rgba(5,42,104,0.45)]">
          <span class="flex size-10 items-center justify-center rounded-full bg-accent-100 font-display text-lg font-800 text-accent-700">0{index + 1}</span>
          <h3 class="mt-5 !text-lg">{feature}</h3>
          <span class="mt-5 block h-1 w-10 bg-accent-500 transition-all group-hover:w-16"></span>
        </div>
      ))}
    </div>
  </Section>

  {/* ============================= DETAILS + SPEC TABLE */}
  <Section tone="alt">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)] lg:items-start">
      <article class="prose-cp min-w-0">
        <div class="mb-8 flex items-center gap-3">
          <span class="h-px w-10 bg-accent-500"></span>
          <p class="eyebrow">Product information</p>
        </div>
        <Content />
      </article>

      <div class="space-y-6 lg:sticky lg:top-28">
        <div class="overflow-hidden rounded-md border border-carbon-200 bg-white shadow-sm">
          <div class="bg-brand-700 px-6 py-5 text-white">
            <p class="eyebrow !text-accent-300">Technical data</p>
            <h2 class="mt-2 !text-2xl !text-white">Preliminary parameters</h2>
            <p class="mt-2 text-sm text-white/70">Use these values for initial sizing. Final selection follows your ore and site data.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[26rem] text-left text-sm">
              <thead class="bg-carbon-50 text-xs uppercase tracking-wider text-carbon-500">
                <tr><th class="px-6 py-3 font-700">Parameter</th><th class="px-6 py-3 text-right font-700">Reference value</th></tr>
              </thead>
              <tbody class="divide-y divide-carbon-100">
                {d.specs.map((s) => (
                  <tr class="align-top">
                    <th scope="row" class="px-6 py-3.5 font-600 text-carbon-600">{s.label}</th>
                    <td class="px-6 py-3.5 text-right font-700 text-brand-700">{s.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="rounded-md bg-carbon-950 p-6 text-white">
          <p class="eyebrow !text-accent-300">Useful information</p>
          <ul class="mt-4 space-y-3">
            {d.applications.slice(0, 3).map((application) => (
              <li class="flex items-start gap-2 text-sm text-white/75"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-400" />{application}</li>
            ))}
          </ul>
          <button class="btn btn-primary mt-6 w-full" onclick={contactAction}>
            Ask for a matched proposal <Icon name="arrowRight" class="size-[1.15em]" />
          </button>
        </div>
      </div>
    </div>
  </Section>

  {/* ============================= APPLICATIONS */}
  <Section eyebrow="Where it fits" title="Designed for a practical product decision" tone="dark">
    <div class="grid gap-4 md:grid-cols-3">
      {d.applications.map((application, index) => (
        <div class="relative overflow-hidden rounded-md border border-white/10 bg-white/5 p-6">
          <span class="font-display text-5xl font-800 text-accent-400/30">0{index + 1}</span>
          <h3 class="mt-4 !text-xl !text-white">{application}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/60">Configuration, wear parts and delivery scope can be matched to this operating environment.</p>
        </div>
      ))}
    </div>
  </Section>

  {/* ============================= DELIVERY */}
  <Section eyebrow="From enquiry to delivery" title="A clearer path to the right configuration">
    <div class="grid gap-0 md:grid-cols-3">
      {[
          ["01", "Share the inputs", "Send the key operating conditions, target output and site requirements so the recommendation starts from real conditions."],
        ["02", "Review the configuration", "We align the model, wear materials, drive arrangement, packing scope and practical operating assumptions."],
        ["03", "Prepare for delivery", "Receive a clear quotation with technical scope, inspection points and export-ready packing details."],
      ].map(([number, title, text], index) => (
        <div class={`relative border-l border-carbon-200 px-6 py-2 md:px-8 ${index === 0 ? "md:border-l-0 md:pl-0" : ""}`}>
          <span class="font-display text-sm font-800 tracking-[0.2em] text-accent-600">{number}</span>
          <h3 class="mt-3 !text-xl">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-carbon-600">{text}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* ============================= PACKAGING CTA */}
  <Section tone="alt">
    <div class="grid gap-10 lg:grid-cols-[1fr_0.8fr] lg:items-center">
      <div>
        <p class="eyebrow">Export and site readiness</p>
        <h2 class="mt-3">The technical scope continues beyond the machine.</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-carbon-600">From protective wrapping and wooden cases to wear-parts lists and installation notes, the delivery package is planned around how the product will reach and operate at your site.</p>
      </div>
      <div class="rounded-md border border-carbon-200 bg-white p-6 shadow-sm">
        <h3 class="!text-lg flex items-center gap-2"><Icon name="truck" class="size-5 text-accent-600" /> Packaging scope</h3>
        <ul class="mt-4 space-y-3">
          {d.packaging.map((p) => (
            <li class="flex items-start gap-2 text-sm text-carbon-600"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-500" />{p}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {/* ============================= PROCUREMENT CTA */}
  {isBallMill ? (
    <section id="request-quote" class="bg-carbon-950 py-16 text-white sm:py-20 lg:py-24">
      <div class="container-x grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow !text-accent-300">Request a ball mill proposal</p>
          <h2 class="mt-4 !text-white">Send the inputs your supplier actually needs.</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/70">A useful quotation starts with the process, not a catalogue model. Share the ore and production target, and we will help narrow the mill size, discharge type, liner/media route and supporting equipment.</p>
          <ul class="mt-7 space-y-3">
            {["Model and capacity recommendation", "Wet/dry and discharge guidance", "Preliminary technical scope", "Export packing and delivery discussion"].map((item) => (
              <li class="flex items-start gap-3 text-sm text-white/78"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-400" />{item}</li>
            ))}
          </ul>
        </div>
        <div class="bg-white p-6 text-carbon-800 shadow-2xl sm:p-8">
          <div class="mb-6 border-b border-carbon-100 pb-5">
            <p class="eyebrow">Ball mill enquiry</p>
            <h3 class="mt-2 !text-2xl">Get a matched recommendation</h3>
            <p class="mt-2 text-sm text-carbon-500">Name and phone are optional. Please include as much process detail as you have in the message.</p>
          </div>
          <ContactForm
            formId="ball-mill-inquiry-form"
            statusId="ball-mill-inquiry-status"
            fieldIdPrefix="ball-mill"
            sourcePage="/products/gold-ore-ball-mill"
            productInterest="Gold Ore Ball Mill"
            ctaLabel="Get a matched model"
            closeModalOnSuccess={false}
          />
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-brand-700 text-white">
      <div class="container-x flex flex-col items-start justify-between gap-6 py-14 sm:py-16 lg:flex-row lg:items-center">
        <div>
          <p class="eyebrow !text-accent-300">Ready to size the product?</p>
          <h2 class="mt-3 !text-white">Turn your process data into a practical proposal.</h2>
          <p class="mt-3 max-w-2xl text-white/70">Tell us what you are processing, what you need to achieve and where the equipment will operate.</p>
        </div>
        <button class="btn btn-primary shrink-0" onclick={contactAction}>Request a Quote <Icon name="arrowRight" class="size-[1.15em]" /></button>
      </div>
    </section>
  )}

  {/* ============================= RELATED */}
  {related.length > 0 && (
    <Section eyebrow="Related products" title="You may also need" tone="alt">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => (
          <ProductCard
            href={`/products/${p.id}`}
            title={p.data.title}
            excerpt={p.data.excerpt}
            icon={p.data.icon}
            category={p.data.category}
            image={productImages[p.id]}
            imageAlt={p.data.heroImageAlt}
          />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
