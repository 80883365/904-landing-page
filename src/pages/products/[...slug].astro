---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import ContactForm from "../../components/ContactForm.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import ballMillHero from "../../assets/images/gold-ore-ball-mill/gold-ore-ball-mill-wide-hero.webp";
import ballMillFactory from "../../assets/images/gold-ore-ball-mill/ball-mill-factory-production-line.webp";
import ballMillDrive from "../../assets/images/gold-ore-ball-mill/compact-ball-mill-drive-assembly.webp";
import wetPanHero from "../../assets/images/wet-pan-mill-for-gold/gold-wet-pan-mill-wide-hero.webp";
import wetPanAssembly from "../../assets/images/wet-pan-mill-for-gold/double-wheel-wet-pan-mill-assembly.webp";
import wetPanLine from "../../assets/images/wet-pan-mill-for-gold/wet-pan-mill-processing-line.webp";
import steelBallHero from "../../assets/images/forged-grinding-steel-balls/forged-grinding-balls-production-batch.webp";
import steelBallInspection from "../../assets/images/forged-grinding-steel-balls/grinding-ball-chemical-composition-inspection.webp";
import steelBallWorkshop from "../../assets/images/forged-grinding-steel-balls/forged-grinding-balls-production-workshop.webp";
import { generateProductSchema, generateBreadcrumbSchema } from "../../config/seo";
import { SITE } from "../../config/site";

export const getStaticPaths = (async () => {
  const products = await getCollection("products");
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

type ProductPlan = {
  heroDescription: string;
  heroPoints: string[];
  snapshot: Array<[string, string]>;
  selection: { title: string; intro: string; points: Array<[string, string]> };
  table: { title: string; intro: string; headers: string[]; rows: string[][]; note: string };
  applications: Array<[string, string]>;
  process: string[];
  evidence: { image: ImageMetadata; alt: string; title: string; intro: string; points: string[] };
  reference: { image: ImageMetadata; alt: string; title: string; intro: string; facts: Array<[string, string]> };
  questions: Array<[string, string]>;
  formTitle: string;
  formIntro: string;
};

const productImages: Record<string, ImageMetadata> = {
  "gold-ore-ball-mill": ballMillHero,
  "wet-pan-mill-for-gold": wetPanHero,
  "forged-grinding-steel-balls": steelBallHero,
};

const productPlans: Record<string, ProductPlan> = {
  "gold-ore-ball-mill": {
    heroDescription: "ZD Mining supplies wet and dry ball mills for gold ore, copper ore and hard-rock mineral processing. Send your feed size, required capacity and recovery route for a matched configuration and quotation.",
    heroPoints: ["Wet or dry grinding configurations for mineral processing circuits", "Overflow or grate discharge matched to product size and slurry flow", "Liner, grinding-media and drive options specified as one working system"],
    snapshot: [["Reference models", "Φ900×1800 to Φ1830×4500"], ["Feed size", "Up to 25 mm, duty dependent"], ["Reference capacity", "0.65–12 t/h"], ["Process options", "Wet/dry · overflow/grate"]],
    selection: {
      title: "Choose a gold ore ball mill by duty, not shell diameter",
      intro: "A reliable quotation begins with the material and recovery route. The same shell size can perform very differently when ore hardness, feed distribution or the final product target changes.",
      points: [["Feed and throughput", "Confirm the crusher discharge, planned tonnes per hour and the variation expected across a normal shift."], ["Target product size", "State the required P80 or downstream liberation target so the mill length, discharge and classification route can be aligned."], ["Circuit interface", "Tell us whether the mill feeds gravity concentration, flotation, leaching or a dry product-handling route."]],
    },
    table: {
      title: "Gold ore ball mill model and capacity guide",
      intro: "Use these figures to shortlist a model. Final capacity depends on ore competency, feed distribution, target product size, circulating load and operating conditions.",
      headers: ["Model", "Feed ≤ mm", "Discharge mm", "Capacity t/h", "Motor kW", "Weight t"],
      rows: [["Φ900×1800", "20", "0.075–0.89", "0.65–2", "18.5", "5.8"], ["Φ900×3000", "20", "0.075–0.89", "1.1–3.5", "22", "6.8"], ["Φ1200×2400", "25", "0.075–0.60", "1.5–4.8", "30", "12"], ["Φ1200×3000", "25", "0.074–0.40", "1.6–5", "37", "13.2"], ["Φ1200×4500", "25", "0.074–0.40", "1.6–5.8", "55", "13.7"], ["Φ1500×3000", "25", "0.074–0.40", "2–5", "75", "16.5"], ["Φ1500×4500", "25", "0.074–0.40", "3–6", "110", "21"], ["Φ1830×3000", "25", "0.074–0.40", "4–10", "130", "34.5"], ["Φ1830×4500", "25", "0.074–0.40", "4.5–12", "155", "38"]],
      note: "Reference values are for preliminary selection only. Confirm the final model with representative ore data and the complete process route.",
    },
    applications: [["Hard-rock gold ore", "Continuous grinding after crushing where a defined liberation size is required before recovery."], ["Gravity, flotation or leaching feed", "Wet-milling configurations can be matched to classification and slurry handling downstream."], ["Copper and mineral processing", "Mill, liner and media choices can be adjusted for abrasive ores and conventional mineral circuits."]],
    process: ["Crush to a controlled feed", "Grind with a selected media charge", "Classify to the target size", "Send a stable feed to recovery"],
    evidence: {
      image: ballMillDrive,
      alt: "Compact ball mill drive assembly prepared in the workshop for mineral processing equipment supply",
      title: "Specify the operating system, not only the mill shell",
      intro: "The mill body, feed and discharge arrangement, girth gear, motor, bearings, liners and media all affect how the equipment performs after installation.",
      points: ["Select overflow or grate discharge around the target product and slurry flow.", "Match liner material and grinding-ball charge to ore abrasiveness and impact conditions.", "Confirm drive voltage, frequency, lubrication and the scope of auxiliary equipment before shipment."],
    },
    reference: {
      image: ballMillFactory,
      alt: "Multiple gold ore ball mills assembled in a manufacturing workshop",
      title: "Reference supply scenario: match the mill to the whole circuit",
      intro: "A practical proposal identifies the mill duty and its interfaces with crushing, classification, pumping and recovery—rather than quoting a model number in isolation.",
      facts: [["Send", "Ore type, feed distribution and target tonnes per hour"], ["Confirm", "Target product size and wet or dry operation"], ["Include", "Recovery method, site power and delivery destination"]],
    },
    questions: [["What capacity can a gold ore ball mill handle?", "Capacity changes with mill dimensions, ore hardness, feed size, product fineness and circulating load. The table is a preliminary guide; representative ore data produces a more useful recommendation."], ["Should I choose wet or dry grinding?", "Wet grinding is common before classification, gravity concentration, flotation or leaching. Dry grinding can suit restricted-water or dry-product duties when dust control and handling are planned."], ["Should I choose overflow or grate discharge?", "Overflow discharge is often selected for controlled fine grinding. Grate discharge can support faster slurry removal. The correct choice depends on the circuit, not capacity alone."]],
    formTitle: "Request a gold ore ball mill quotation",
    formIntro: "Share the duty you know today. Our team will use it to narrow the mill size, discharge arrangement and supporting scope.",
  },
  "wet-pan-mill-for-gold": {
    heroDescription: "ZD Mining supplies double-wheel wet pan mills for small-scale gold mining, hard-rock gold processing and gravity-recovery applications. Send your feed size and target capacity for a matched model and export quotation.",
    heroPoints: ["1100–1600 model range for practical small- and medium-scale duties", "Double-wheel grinding with a compact footprint and modest installed power", "Configuration matched to crusher discharge, available power and downstream recovery"],
    snapshot: [["Common models", "1100 · 1200 · 1400 · 1500 · 1600"], ["Feed size", "Up to 20–30 mm"], ["Reference capacity", "0.5–3 t/h"], ["Installed power", "5.5–37 kW"]],
    selection: {
      title: "Select a wet pan mill around the site, feed and recovery step",
      intro: "A wet pan mill is a grinding and slurry-mixing stage. It should be selected with the crusher, water supply and downstream concentrator or shaking table—not treated as a standalone recovery claim.",
      points: [["Feed after crushing", "Keep rock below the stated feed limit. Oversize material increases wear and makes the grinding duty unstable."], ["Hourly throughput", "Choose the pan diameter and motor power around the normal operating rate, not a short-term peak."], ["Site utilities and recovery", "Confirm available power, water and whether the mill feeds a concentrator, shaking table or another separation stage."]],
    },
    table: {
      title: "Wet pan mill models for preliminary selection",
      intro: "These common model ranges help compare feed, power and nominal throughput. Final output depends on ore hardness, water addition, feed consistency and operating practice.",
      headers: ["Model", "Feed < mm", "Output < mm", "Capacity t/h", "Speed rpm", "Power kW", "Weight t"],
      rows: [["1100", "20", "1", "0.5", "11–19", "5.5", "4.8"], ["1200", "20", "1", "0.5–1", "11–19", "7.5", "5.2"], ["1400", "20", "1", "1–1.5", "18–21", "15", "9.5"], ["1500", "30", "1", "1.5–2", "18–22", "22", "11"], ["1600", "30", "1", "2–3", "18–20", "30/37", "12.5"]],
      note: "Model data is a reference selection range. The final specification should be confirmed against your ore, operating target and available site utilities.",
    },
    applications: [["Small-scale rock gold", "A compact grinding stage for crushed hard-rock gold ore before the selected recovery step."], ["Gravity recovery preparation", "Grinds and mixes feed for a process route that may include a concentrator or shaking table."], ["Remote or modest-power sites", "A practical option when footprint, installed power and straightforward maintenance are central to the purchase decision."]],
    process: ["Crush below the feed limit", "Add water and grind in the pan", "Control the slurry and product size", "Feed the chosen recovery equipment"],
    evidence: {
      image: wetPanAssembly,
      alt: "Double-wheel wet pan mill assembly with pan, rollers and support frame for gold ore processing",
      title: "Focus the quote on wear parts, drive and working access",
      intro: "For a wet pan mill, the roller and ring materials, drive arrangement and access for routine maintenance have a direct effect on operation after delivery.",
      points: ["Confirm the roller, ring and pan material for the planned ore and expected wear conditions.", "Specify motor, reducer and electrical compatibility with the site power supply.", "Include the starter wear-parts list and installation dimensions in the supply scope."],
    },
    reference: {
      image: wetPanLine,
      alt: "Multiple wet pan mills arranged in a mineral processing equipment workshop",
      title: "Reference supply scenario: build a simple, connected gold-processing step",
      intro: "The mill performs best when its feed and discharge are planned with the equipment on either side of it. A basic circuit can stay simple while still making each interface clear.",
      facts: [["Before the mill", "Crusher discharge and any screening step"], ["At the mill", "Ore feed rate, water addition and available power"], ["After the mill", "Concentrator, shaking table or other chosen recovery route"]],
    },
    questions: [["Is a wet pan mill better than a ball mill?", "They suit different duties. Wet pan mills are commonly used for lower-throughput, compact gold-processing routes; ball mills suit continuous and higher-capacity circuits with tighter product-size control."], ["Does a wet pan mill recover gold by itself?", "No. It grinds and mixes the ore. Recovery depends on mineralogy, liberation and the concentration or leaching stage that follows."], ["How do I choose between the 1200 and 1500 models?", "Start with maximum feed size, normal hourly throughput, site power and the recovery route. A larger model is not automatically a better result if the crusher and downstream equipment cannot support it."]],
    formTitle: "Request a wet pan mill quotation",
    formIntro: "Tell us your ore, feed size, expected tonnes per hour and site power. We will help you shortlist the model and supply scope.",
  },
  "forged-grinding-steel-balls": {
    heroDescription: "ZD Mining supplies forged grinding steel balls for gold, copper and mineral processing ball mills. Tell us your mill size, ball diameter and required grade for a matched quotation and delivery plan.",
    heroPoints: ["20–150 mm diameter range for mineral grinding and ball-mill top-up programs", "Forged or hot-rolled options with grade, hardness and impact needs reviewed together", "Batch-oriented supply planning for inspection, packing and scheduled replenishment"],
    snapshot: [["Diameter range", "20–150 mm"], ["Typical hardness", "HRC 55–65, grade dependent"], ["Manufacturing", "Forged or hot rolled"], ["Packing options", "Bulk bags, drums or export packing"]],
    selection: {
      title: "Choose grinding steel balls by wear, impact and mill conditions",
      intro: "Grinding media is a recurring operating cost. A useful recommendation considers the working mill and the ore—not only the requested ball diameter or the highest possible hardness number.",
      points: [["Mill and charge practice", "Share mill diameter, operating speed, current ball-size mix and normal top-up practice."], ["Ore and impact severity", "Hardness, abrasiveness and feed size influence the balance required between wear resistance and toughness."], ["Consumption and delivery", "Current media consumption and delivery frequency help define a practical batch size and replenishment plan."]],
    },
    table: {
      title: "Forged grinding steel ball size and application guide",
      intro: "These ranges provide a practical discussion starting point. The recommended charge is usually a size mix, selected around feed size, mill dimensions and the required product size.",
      headers: ["Diameter range", "Typical duty", "Selection focus", "Supply discussion"],
      rows: [["20–40 mm", "Fine or regrind duties", "Product-size control and wear rate", "Confirm the existing small-ball fraction"], ["50–80 mm", "Conventional ball-mill grinding", "Balance impact and abrasion", "Match to feed size and mill diameter"], ["90–125 mm", "Coarser feed or higher-impact duties", "Toughness, roundness and breakage resistance", "Review mill speed and impact conditions"], ["125–150 mm", "Heavy-duty or large-media requirements", "Grade selection and handling plan", "Confirm mill design and lifting equipment"]],
      note: "Final diameter mix, chemical composition and hardness profile should be agreed from the actual mill, ore and consumption data. Do not select solely by one headline HRC value.",
    },
    applications: [["Gold and copper ball mills", "Application-matched media for conventional mineral grinding circuits and scheduled top-up supply."], ["High-impact mineral grinding", "Forged media is commonly considered when toughness and resistance to breakage are critical in the operating duty."], ["Cement and processing plants", "Diameter, material and packing can be tailored to the mill, expected wear pattern and purchasing schedule."]],
    process: ["Review the mill and current charge", "Set the grade and diameter mix", "Inspect the agreed batch", "Plan packing and replenishment"],
    evidence: {
      image: steelBallInspection,
      alt: "Forged grinding balls beside an optical spectrometer during chemical composition inspection",
      title: "Make inspection points part of the purchase specification",
      intro: "For grinding media, batch consistency matters as much as the product name. Inspection should focus on the characteristics that affect consumption and breakage in the actual mill.",
      points: ["Agree the requested diameter range, size tolerance and intended ball-size mix before production.", "Review the grade, chemical-composition check and hardness requirements for the duty.", "Confirm packing format, net weight per unit and shipment schedule before the batch is released."],
    },
    reference: {
      image: steelBallWorkshop,
      alt: "Forged grinding steel ball production workshop with material stock and manufacturing line",
      title: "Reference supply scenario: connect media selection with replenishment planning",
      intro: "The most useful media order combines a fit-for-duty grade with a delivery plan that supports the mill's normal top-up practice and site handling capability.",
      facts: [["Identify", "Mill type, ball-size mix and current consumption"], ["Confirm", "Ore abrasiveness, breakage concern and grade requirements"], ["Plan", "Monthly volume, packing format and delivery destination"]],
    },
    questions: [["What ball size is used in gold ore mills?", "Most mills run a graded charge, not one diameter. The mix depends on feed size, mill dimensions, operating speed and the target product size."], ["Forged or cast grinding balls—which should I choose?", "Forged media is commonly preferred for high-impact duties where toughness matters. Cast media can suit other conditions. The right choice should be based on the working duty and total consumption, not a general rule."], ["What information is needed for a comparable steel-ball quote?", "Send the current ball size, grade or composition if known, hardness requirement, mill details, monthly consumption and delivery destination. These inputs allow a more meaningful comparison than price per tonne alone."]],
    formTitle: "Request a forged grinding steel ball quotation",
    formIntro: "Share the mill duty, diameter range and expected volume. We will help define the most relevant grade, packing and delivery basis.",
  },
};

const { product } = Astro.props;
const d = product.data;
const plan = productPlans[product.id] ?? productPlans["gold-ore-ball-mill"];
const seoTitles: Record<string, string> = {
  "gold-ore-ball-mill": "Gold Ore Ball Mill Supplier & Model Guide",
  "wet-pan-mill-for-gold": "Wet Pan Mill for Gold Model Guide & Supplier",
  "forged-grinding-steel-balls": "Forged Grinding Steel Ball Supplier & Size Guide",
};
const seoTitle = seoTitles[product.id] ?? d.title;
const heroImage = productImages[product.id] ?? ballMillHero;
const heroImageAlt = d.heroImageAlt || d.title;
const allProducts = (await getCollection("products")).filter((item) => item.id !== product.id);
const related = [...allProducts.filter((item) => item.data.category === d.category), ...allProducts.filter((item) => item.data.category !== d.category)].slice(0, 3);
const contactAction = `openContactModal(${JSON.stringify({ sourcePage: `/products/${product.id}`, productInterest: d.title, ctaLabel: "Request a Quote" })})`;
const productSchema = generateProductSchema({ name: d.title, description: d.description, image: new URL(heroImage.src, SITE.url).href, url: new URL(`/products/${product.id}`, SITE.url).href });
const breadcrumbSchema = generateBreadcrumbSchema([{ name: "Home", url: SITE.url }, { name: "Products", url: new URL("/products", SITE.url).href }, { name: d.title, url: new URL(`/products/${product.id}`, SITE.url).href }]);
const jsonLd = { "@context": "https://schema.org", "@graph": [productSchema, breadcrumbSchema] };
---

<BaseLayout title={seoTitle} description={d.description} image={heroImage.src} type="website" jsonLd={jsonLd}>
  <section class="relative overflow-hidden bg-carbon-950 text-white">
    <div class="container-x relative py-12 sm:py-16 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 min-w-0"><ol class="flex min-w-0 items-center gap-2 text-sm text-white/55"><li class="shrink-0"><a href="/" class="transition hover:text-accent-300">Home</a></li><li class="shrink-0"><Icon name="chevronRight" class="size-3.5 opacity-50" /></li><li class="shrink-0"><a href="/products" class="transition hover:text-accent-300">Products</a></li><li class="shrink-0"><Icon name="chevronRight" class="size-3.5 opacity-50" /></li><li class="min-w-0 flex-1"><span class="block truncate text-white/85">{d.title}</span></li></ol></nav>
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div class="min-w-0"><h1 class="max-w-3xl !text-white">{d.title}</h1><p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/72">{plan.heroDescription}</p><ul class="mt-7 space-y-3">{plan.heroPoints.map((point) => <li class="flex items-start gap-2 text-sm text-white/82"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-400" />{point}</li>)}</ul><div class="mt-8"><button class="btn btn-primary" onclick={contactAction}>Request a Quote <Icon name="arrowRight" class="size-[1.15em]" /></button></div></div>
        <div class="relative lg:-mr-[max(2rem,calc((100vw-80rem)/2+2rem))]"><div class="overflow-hidden border border-white/15 bg-carbon-900 shadow-2xl"><OptimizedImage src={heroImage} alt={heroImageAlt} class="aspect-[16/10] w-full object-cover" loading="eager" fetchpriority="high" widths={[480, 640, 720, 960, 1280, 1536]} sizes="(min-width: 1024px) 55vw, 100vw" /></div></div>
      </div>
    </div>
  </section>

  <section class="border-b border-carbon-200 bg-white"><div class="container-x grid gap-px overflow-hidden border-x border-carbon-200 bg-carbon-200 sm:grid-cols-2 lg:grid-cols-4">{plan.snapshot.map(([label, value]) => <div class="bg-white px-6 py-6 sm:px-7"><p class="text-xs font-700 uppercase tracking-[0.14em] text-carbon-500">{label}</p><p class="mt-2 text-base font-700 leading-snug text-brand-700">{value}</p></div>)}</div></section>

  <Section><div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start"><div><h2>{plan.selection.title}</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-carbon-600">{plan.selection.intro}</p></div><div class="grid gap-px border border-carbon-200 bg-carbon-200 md:grid-cols-3">{plan.selection.points.map(([title, text], index) => <div class="bg-white p-6"><span class="font-display text-sm font-800 tracking-[0.16em] text-accent-600">0{index + 1}</span><h3 class="mt-4 !text-xl">{title}</h3><p class="mt-3 text-sm leading-relaxed text-carbon-600">{text}</p></div>)}</div></div></Section>

  <Section tone="alt"><div><h2>{plan.table.title}</h2><p class="mt-4 max-w-3xl text-lg leading-relaxed text-carbon-600">{plan.table.intro}</p></div><div class="mt-10 overflow-x-auto border border-carbon-200 bg-white"><table class="w-full min-w-[50rem] text-left text-sm"><thead class="bg-brand-700 text-xs uppercase tracking-wider text-white"><tr>{plan.table.headers.map((header) => <th class="px-5 py-4 font-700">{header}</th>)}</tr></thead><tbody class="divide-y divide-carbon-100">{plan.table.rows.map((row, rowIndex) => <tr class={rowIndex % 2 ? "bg-carbon-50/70" : "bg-white"}>{row.map((value, cellIndex) => <td class={`px-5 py-4 ${cellIndex === 0 ? "font-700 text-brand-700" : "text-carbon-600"}`}>{value}</td>)}</tr>)}</tbody></table></div><p class="mt-4 text-sm leading-relaxed text-carbon-500">{plan.table.note}</p></Section>

  <Section tone="dark"><div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center"><div><h2 class="!text-white">Where {d.title} fits in the decision</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-white/65">The product page should help you clarify the application before any model, grade or delivery scope is confirmed.</p><div class="mt-8 grid gap-3">{plan.applications.map(([title, text]) => <div class="border-l-2 border-accent-400 bg-white/5 p-5"><h3 class="!text-lg !text-white">{title}</h3><p class="mt-2 text-sm leading-relaxed text-white/65">{text}</p></div>)}</div></div><div class="min-w-0"><div class="grid gap-px border border-white/15 bg-white/10 sm:grid-cols-2">{plan.process.map((step, index) => <div class="bg-carbon-900 p-6"><span class="font-display text-sm font-800 tracking-[0.16em] text-accent-400">0{index + 1}</span><p class="mt-4 text-lg font-700 leading-snug text-white">{step}</p></div>)}</div></div></div></Section>

  <Section><div class="grid gap-10 lg:grid-cols-2 lg:items-center"><figure class="overflow-hidden border border-carbon-200 bg-carbon-50"><OptimizedImage src={plan.evidence.image} alt={plan.evidence.alt} class="aspect-[16/10] w-full object-cover" loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" /></figure><div><h2>{plan.evidence.title}</h2><p class="mt-5 text-lg leading-relaxed text-carbon-600">{plan.evidence.intro}</p><ul class="mt-7 space-y-4">{plan.evidence.points.map((point) => <li class="flex items-start gap-3 border-t border-carbon-200 pt-4 text-sm leading-relaxed text-carbon-700"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-600" />{point}</li>)}</ul></div></div></Section>

  <Section tone="alt"><div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"><figure class="overflow-hidden border border-carbon-200 bg-white"><OptimizedImage src={plan.reference.image} alt={plan.reference.alt} class="aspect-[16/10] w-full object-cover" loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" /></figure><div><h2>{plan.reference.title}</h2><p class="mt-5 text-lg leading-relaxed text-carbon-600">{plan.reference.intro}</p><dl class="mt-8 divide-y divide-carbon-200 border-y border-carbon-200">{plan.reference.facts.map(([term, detail]) => <div class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-5"><dt class="font-700 text-brand-700">{term}</dt><dd class="text-sm leading-relaxed text-carbon-600">{detail}</dd></div>)}</dl></div></div></Section>

  <Section><div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start"><div><h2>Buyer questions before you request a quote</h2><p class="mt-4 max-w-md text-lg leading-relaxed text-carbon-600">Clear inputs and realistic expectations produce a more useful technical and commercial response.</p></div><div class="divide-y divide-carbon-200 border-y border-carbon-200">{plan.questions.map(([question, answer]) => <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-700 text-brand-800"><span>{question}</span><span class="text-2xl font-400 text-accent-600 transition-transform group-open:rotate-45">+</span></summary><p class="mt-4 max-w-3xl pr-8 text-sm leading-relaxed text-carbon-600">{answer}</p></details>)}</div></div></Section>

  <section id="request-quote" class="bg-carbon-950 py-16 text-white sm:py-20 lg:py-24"><div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16"><div class="lg:sticky lg:top-28"><h2 class="!text-white">{plan.formTitle}</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">{plan.formIntro}</p><ul class="mt-8 space-y-3">{["A product configuration or grade matched to the information supplied", "Clear technical scope and preliminary supply discussion", "Export packing and delivery options when the destination is known"].map((item) => <li class="flex items-start gap-3 text-sm text-white/78"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent-400" />{item}</li>)}</ul></div><div class="bg-white p-6 text-carbon-800 shadow-2xl sm:p-8"><div class="mb-6 border-b border-carbon-100 pb-5"><h3 class="!text-2xl">Send your requirements</h3><p class="mt-2 text-sm leading-relaxed text-carbon-500">Name and phone are optional. Use the message field for the operating conditions, specification or delivery details you already have.</p></div><ContactForm formId={`${product.id}-inquiry-form`} statusId={`${product.id}-inquiry-status`} fieldIdPrefix={`${product.id}-inquiry`} sourcePage={`/products/${product.id}`} productInterest={d.title} ctaLabel="Request a Quote" closeModalOnSuccess={false} /></div></div></section>

  {related.length > 0 && <Section title="Related products" tone="alt"><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{related.map((item) => <ProductCard href={`/products/${item.id}`} title={item.data.title} excerpt={item.data.excerpt} icon={item.data.icon} category={item.data.category} image={productImages[item.id]} imageAlt={item.data.heroImageAlt} />)}</div></Section>}
</BaseLayout>
