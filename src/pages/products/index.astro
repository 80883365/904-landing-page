---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getCollection } from "astro:content";
import categoryImg from "../../assets/images/products/gold-ore-processing-mills.webp";
import ballMillImg from "../../assets/images/gold-ore-ball-mill/industrial-ball-mill.webp";
import wetPanImg from "../../assets/images/wet-pan-mill-for-gold/double-wheel-wet-pan-mill.webp";
import steelBallsImg from "../../assets/images/forged-grinding-steel-balls/forged-steel-grinding-balls.webp";
const products = (await getCollection("products")).sort((a,b)=>a.data.order-b.data.order);
const images: Record<string, ImageMetadata> = {"gold-ore-ball-mill":ballMillImg,"wet-pan-mill-for-gold":wetPanImg,"forged-grinding-steel-balls":steelBallsImg};
---
<BaseLayout title="Gold Mining Equipment & Grinding Media" description="Compare gold ore ball mills, wet pan mills and forged grinding steel balls for small-scale and continuous mineral processing plants." image={categoryImg.src}>
  <section class="relative overflow-hidden bg-carbon-950 text-white"><OptimizedImage src={categoryImg} alt="Gold ore processing site with crushing and grinding equipment" class="absolute inset-0 h-full w-full object-cover opacity-40" loading="eager" fetchpriority="high" widths={[640, 1024, 1200]} sizes="100vw" /><div class="absolute inset-0 bg-gradient-to-r from-carbon-950 via-carbon-950/85 to-transparent"></div><div class="container-x relative py-20 sm:py-24"><nav class="text-sm text-white/65"><a href="/">Home</a> / Products</nav><h1 class="mt-5 max-w-3xl !text-white">Gold mining grinding equipment and media</h1><p class="mt-5 max-w-2xl text-lg text-white/80">Three focused product lines covering small-scale ore grinding, continuous fine grinding and the consumable media that keeps mills productive.</p></div></section>
  <Section><div class="grid gap-6 lg:grid-cols-3">{products.map((p)=><ProductCard href={`/products/${p.id}`} title={p.data.title} excerpt={p.data.excerpt} icon={p.data.icon} category={p.data.category} image={images[p.id]} imageAlt={p.data.heroImageAlt} />)}</div></Section>
  <Section tone="dark" align="center" title="Not sure which grinding route fits?" intro="Share ore type, feed size, target fineness and tonnes per hour. We will narrow the equipment options before quotation." containerClass="!max-w-3xl"><button class="btn btn-primary" onclick="openContactModal({ sourcePage: '/products', ctaLabel: 'Ask for Model Selection' })">Ask for Model Selection <Icon name="arrowRight" class="size-4" /></button></Section>
</BaseLayout>
