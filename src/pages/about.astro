---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import facilityImg from "../assets/images/about/mineral-processing-facility.webp";
---
<BaseLayout title="About ZD Mining Mining Equipment" description="ZD Mining focuses on practical gold ore grinding equipment, mill consumables and application-led support for international mineral processing projects." image={facilityImg.src}>
  <section class="bg-brand-800 py-16 text-white sm:py-20"><div class="container-x"><nav class="text-sm text-white/65"><a href="/">Home</a> / About</nav><h1 class="mt-5 max-w-3xl !text-white">A focused partner for gold ore grinding</h1><p class="mt-5 max-w-2xl text-lg text-white/80">We bring equipment and grinding media into one practical supply conversation—so model selection starts with the ore, the recovery route and the realities of the site.</p></div></section>
  <Section><div class="grid gap-10 lg:grid-cols-2 lg:items-center"><div><h2>Engineering questions before catalogue answers</h2><p class="mt-5 text-lg text-carbon-500">Gold processing projects range from small gravity plants to continuous hard-rock circuits. A useful proposal must account for feed size, ore hardness, target liberation size, power availability, water and downstream recovery.</p><p class="mt-4 text-carbon-500">Our initial product scope is deliberately focused: gold ore ball mills, wet pan mills and forged grinding steel balls. This makes it easier to connect capital equipment with the consumables and operating decisions that follow.</p><button class="btn btn-primary mt-7" onclick="openContactModal({ sourcePage: '/about', ctaLabel: 'Discuss a Project' })">Discuss a Project <Icon name="arrowRight" class="size-4" /></button></div><div class="overflow-hidden rounded-md"><OptimizedImage src={facilityImg} alt="Gold mine mineral processing facility and grinding circuit infrastructure" class="aspect-[14/9] w-full object-cover" loading="lazy" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" /></div></div></Section>
  <Section tone="alt" title="What a useful inquiry includes"><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">{[["ruler","Process inputs","Ore type, feed size, target P80 and throughput."],["factory","Site conditions","Voltage, frequency, altitude, water and footprint."],["shield","Supply scope","Mill, drive, liner, media, auxiliaries and spares."],["truck","Delivery plan","Destination, packing, installation and commissioning needs."]].map(([icon,title,text])=><div class="card p-6"><Icon name={icon} class="size-7 text-accent-600"/><h3 class="mt-5 !text-lg">{title}</h3><p class="mt-2 text-sm text-carbon-500">{text}</p></div>)}</div></Section>
</BaseLayout>
