---
/**
 * Thank-you page — shown after every successful inquiry form submission.
 * No header/footer (chrome=false): keep the visitor focused on continuing
 * the conversation on WhatsApp / WeChat via QR codes.
 *
 * Conversion tracking: GTM can fire conversion tags on the /thank-you
 * pageview or the `generate_lead` dataLayer event pushed below.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { CONTACT } from "../consts";
import { Image } from "astro:assets";
import wechatQr from "../assets/images/thank-you/wechat-qr.webp";
import whatsappQr from "../assets/images/thank-you/whatsapp-qr.webp";

const whatsappLink = "https://wa.me/8617335791762";
---

<BaseLayout
  title="Thank You — Inquiry Received"
  description="Your inquiry has been received. Scan the QR code or chat on WhatsApp for the fastest reply."
  chrome={false}
>
  <section
    class="relative flex min-h-screen items-center overflow-hidden py-20"
    style="background:
      radial-gradient(1100px 500px at 85% -10%, rgba(227,163,25,0.28), transparent 60%),
      radial-gradient(900px 500px at 0% 110%, rgba(227,163,25,0.16), transparent 55%),
      linear-gradient(160deg, #0b1220 0%, #111a2e 45%, #1a1508 100%);"
  >
    {/* Gold accent lines */}
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/60 to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-500/40 to-transparent" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-3xl px-4 text-center sm:px-6">
      <div
        class="mx-auto flex size-16 items-center justify-center rounded-full border border-brand-500/30 bg-brand-500/15 text-brand-400"
        aria-hidden="true"
      >
        <Icon name="check" class="size-8" />
      </div>

      <h1 class="mt-8 text-3xl font-800 text-white sm:text-4xl">
        Thank You — Your Inquiry Has Been Received
      </h1>

      <p class="mx-auto mt-5 max-w-md text-base leading-7 text-carbon-300">
        We'll reply within 24 hours. Need it faster? Scan below.
      </p>

      {/* WhatsApp primary CTA */}
      <div class="mt-9 flex flex-col items-center justify-center gap-3">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary inline-flex items-center gap-2.5 text-base"
        >
          <Icon name="whatsapp" class="size-5" />
          Chat with us on WhatsApp
        </a>
        <p class="text-sm text-carbon-400">
          {CONTACT.whatsapp} — phone &amp; WhatsApp
        </p>
      </div>

      {/* QR codes */}
      <div class="mx-auto mt-12 grid w-full max-w-sm grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-md bg-white p-2 shadow-[0_24px_60px_-30px_rgba(227,163,25,0.45)]">
          <Image
            src={whatsappQr}
            alt="GoldCore WhatsApp QR code"
            class="aspect-square w-full"
            widths={[160, 320]}
            loading="eager"
          />
          <p class="pb-0.5 pt-1.5 text-center text-sm font-700 text-carbon-900">WhatsApp</p>
        </div>
        <div class="overflow-hidden rounded-md bg-white p-2 shadow-[0_24px_60px_-30px_rgba(227,163,25,0.45)]">
          <Image
            src={wechatQr}
            alt="GoldCore WeChat QR code"
            class="aspect-square w-full"
            widths={[160, 320]}
            loading="eager"
          />
          <p class="pb-0.5 pt-1.5 text-center text-sm font-700 text-carbon-900">WeChat</p>
        </div>
      </div>

      <div class="mt-10 border-t border-white/10 pt-8">
        <a
          href="/"
          class="text-sm font-600 text-carbon-400 underline decoration-white/25 underline-offset-4 transition hover:text-brand-400"
        >
          ← Back to home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Conversion signal for Google Tag Manager: fires alongside the
  // /thank-you pageview so GTM can trigger conversion tags.
  // (WhatsApp clicks are tracked globally in BaseLayout.)
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: "generate_lead" });
</script>
