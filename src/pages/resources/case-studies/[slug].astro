---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import OptimizedImage from "../../../components/OptimizedImage.astro";
import Field from "../../../components/Field.astro";
import Icon from "../../../components/Icon.astro";
import { SITE } from "../../../consts";
import mineImg from "../../../assets/images/case-studies/gold-mine-upgrade.webp";
import plantImg from "../../../assets/images/case-studies/plant-startup.webp";
import mediaImg from "../../../assets/images/case-studies/media-supply.webp";
import type { GetStaticPaths } from "astro";
const cases = {
  "small-mine-capacity-upgrade": { title: "A practical capacity upgrade for a small gold mine", intro: "A staged planning example for a small operation that needed a clearer next step.", image: mineImg, alt: "Small gold mine capacity upgrade", challenge: "The team needed to improve output while keeping the first investment manageable and leaving room for later expansion.", approach: ["Map the current feed, target output and available utilities.", "Separate immediate equipment needs from future expansion items.", "Confirm wear parts, delivery scope and operator requirements before final selection."], outcome: "The result is a clearer procurement brief: a defined first stage, realistic technical questions and a practical path to add capacity later." },
  "new-processing-line-startup": { title: "Planning a new processing line around site conditions", intro: "A project framework for turning site information into a workable supply scope.", image: plantImg, alt: "New mineral processing line startup", challenge: "The project had a target output but needed to connect that target with feed variation, power, water, layout and delivery responsibilities.", approach: ["Collect the information that affects selection and installation.", "Review the product route together with supporting equipment and site readiness.", "Clarify what is included in the quotation, packing plan and commissioning support."], outcome: "The project team can compare quotations on scope and fit, not only on headline equipment price." },
  "grinding-media-supply-program": { title: "Building a more predictable grinding media supply", intro: "A supply example focused on continuity, grade selection and replenishment planning.", image: mediaImg, alt: "Grinding media supply program", challenge: "Unplanned replenishment and inconsistent media specifications can make operating costs and mill performance difficult to control.", approach: ["Review mill size, operating conditions and current wear patterns.", "Match media grade and size range to the operating objective.", "Create a replenishment rhythm around expected usage and delivery lead time."], outcome: "The buyer has a repeatable supply conversation and a clearer basis for comparing grades, quantities and delivery timing." },
};
export const getStaticPaths = (() => [
  { params: { slug: "small-mine-capacity-upgrade" } },
  { params: { slug: "new-processing-line-startup" } },
  { params: { slug: "grinding-media-supply-program" } },
]) satisfies GetStaticPaths;
const data = cases[Astro.params.slug as keyof typeof cases];
---
<BaseLayout title={data.title} description={data.intro} image={data.image.src} type="article">
  <PageHero tone="dark" title={data.title} intro={data.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources" }, { label: "Case studies", href: "/resources/case-studies" }, { label: data.title }]} />
  <Section>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
      <article class="min-w-0">
        <OptimizedImage src={data.image} alt={data.alt} class="aspect-[16/9] w-full rounded-md object-cover" loading="eager" fetchpriority="high" />
        <section class="mt-10"><h2>Project overview</h2><p class="mt-4 max-w-3xl text-lg leading-relaxed text-carbon-600">{data.challenge}</p></section>
        <section class="mt-12 border-t border-carbon-100 pt-10"><h2>What the project team focused on</h2><div class="mt-7 grid gap-5 md:grid-cols-3">{data.approach.map((item, i) => <div class="card p-6"><span class="font-display text-3xl font-800 text-accent-600">0{i + 1}</span><p class="mt-4 text-carbon-600">{item}</p></div>)}</div></section>
        <section class="mt-12 border-t border-carbon-100 pt-10"><h2>Project result</h2><p class="mt-4 max-w-3xl text-xl leading-relaxed text-carbon-600">{data.outcome}</p></section>
      </article>
      <aside class="space-y-5 lg:sticky lg:top-28">
        <div class="card p-6">
          <h2 class="!text-lg">Discuss a similar project</h2>
          <p class="mt-2 text-sm text-carbon-500">Tell us your requirements and we'll reply within 24 hours.</p>
          <form
            id="case-study-form"
            data-inquiry-form
            data-close-modal="false"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="mt-5 space-y-4"
          >
            <input type="hidden" name="access_key" value={SITE.web3formsKey} />
            <input type="hidden" name="subject" value="New inquiry from ZD Mining website" />
            <input type="hidden" name="from_name" value="ZD Mining Website" />
            <input type="hidden" name="redirect" value={`${SITE.url}/thank-you`} />
            <input type="hidden" name="source_page" value={`/resources/case-studies/${Astro.params.slug}`} />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <Field label="Name" name="name" id="case-name" />
            <Field label="Email *" name="email" id="case-email" type="email" required />
            <div>
              <label for="case-message" class="mb-1.5 block text-sm font-700 text-carbon-700">Your requirements *</label>
              <textarea
                id="case-message"
                name="message"
                required
                rows="4"
                placeholder="Ore type, capacity, timeline…"
                class="w-full rounded-xs border border-carbon-200 bg-white px-3.5 py-2.5 text-base outline-none transition focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-full text-base">
              Send inquiry <Icon name="arrowRight" class="size-4" />
            </button>

            <p id="case-form-status" data-form-status class="hidden rounded-xs border p-4 text-sm" role="status" aria-live="polite"></p>
          </form>
        </div>
      </aside>
    </div>
  </Section>
  <Section><a href="/resources/case-studies" class="font-700 text-accent-700 underline decoration-accent-300 underline-offset-4">Back to case studies →</a></Section>
</BaseLayout>
