---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import OptimizedImage from "../../../components/OptimizedImage.astro";
import chooseImg from "../../../assets/images/blog/choosing-equipment.webp";
import prepImg from "../../../assets/images/blog/project-preparation.webp";
import exportImg from "../../../assets/images/blog/export-checklist.webp";
import type { GetStaticPaths } from "astro";
const posts = {
  "how-to-compare-mining-equipment": { title: "How to compare mining equipment before requesting a quote", image: chooseImg, alt: "Comparing mining equipment before purchase", intro: "A practical checklist for comparing fit, scope, operating conditions and support.", sections: [["Start with the operating objective", "Define what the equipment needs to achieve, then compare capacity, duty, utilities and product fit against that objective."], ["Compare the complete scope", "A useful comparison includes auxiliaries, wear parts, packing, documents and support—not only the main machine."], ["Ask questions that improve the recommendation", "Feed conditions, target output, site limitations and delivery destination help a supplier respond with something more useful than a catalogue model."]] },
  "what-to-prepare-before-equipment-selection": { title: "What to prepare before equipment selection", image: prepImg, alt: "Preparing project information for equipment selection", intro: "The practical information that helps a supplier make a more useful first recommendation.", sections: [["Project context", "Share the application, current process, expected production objective and any limits on space, power, water or handling."], ["Material and operating information", "Provide representative feed details, size range, moisture, hardness or other properties that could affect the product choice."], ["Commercial and delivery needs", "Clarify destination, preferred delivery terms, timing and the level of installation or commissioning support you expect."]] },
  "export-equipment-delivery-checklist": { title: "An export equipment delivery checklist", image: exportImg, alt: "Export equipment delivery checklist", intro: "Key questions about packing, documents, site readiness and follow-up support.", sections: [["Packing and documentation", "Confirm packing method, component marking, manuals, spare parts lists and the documents needed for customs and receiving."], ["Site readiness", "Check foundations, access, lifting, power, water, storage and the people responsible for receiving and installation."], ["After dispatch", "Agree how questions, replacement parts and technical follow-up will be handled after the shipment leaves the factory."]] },
};
export const getStaticPaths = (() => [
  { params: { slug: "how-to-compare-mining-equipment" } },
  { params: { slug: "what-to-prepare-before-equipment-selection" } },
  { params: { slug: "export-equipment-delivery-checklist" } },
]) satisfies GetStaticPaths;
const data = posts[Astro.params.slug as keyof typeof posts];
---
<BaseLayout title={data.title} description={data.intro} image={data.image.src} type="article">
  <PageHero tone="dark" title={data.title} intro={data.intro} crumbs={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources" }, { label: "Blog", href: "/resources/blog" }, { label: data.title }]} />
  <Section>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
      <article class="prose-cp min-w-0">
        <OptimizedImage src={data.image} alt={data.alt} class="mb-10 aspect-[16/9] w-full rounded-md object-cover" loading="eager" fetchpriority="high" />
        {data.sections.map((section) => <section id={section[0].toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="mb-10"><h2>{section[0]}</h2><p>{section[1]}</p></section>)}
      </article>
      <aside class="space-y-5 lg:sticky lg:top-28">
        <div class="card p-6"><h2 class="!text-lg">In this article</h2><ul class="mt-4 space-y-3">{data.sections.map((section) => <li><a href={`#${section[0].toLowerCase().replace(/[^a-z0-9]+/g, "-")}`} class="font-700 text-accent-700 underline decoration-accent-300 underline-offset-4">{section[0]}</a></li>)}</ul></div>
        <div class="bg-brand-700 p-6 text-white"><h2 class="!text-lg !text-white">Have a project question?</h2><p class="mt-3 text-sm leading-relaxed text-white/75">Share your project context and our team will help you identify the next useful step.</p><button class="btn btn-primary mt-5 w-full" onclick={`openContactModal({ sourcePage: '/resources/blog/${Astro.params.slug}', ctaLabel: 'Ask a question' })`}>Ask a question</button></div>
      </aside>
    </div>
  </Section>
</BaseLayout>
