---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import OptimizedImage from "../../../components/OptimizedImage.astro";
import chooseImg from "../../../assets/images/blog/choosing-equipment.webp";
import prepImg from "../../../assets/images/blog/project-preparation.webp";
import exportImg from "../../../assets/images/blog/export-checklist.webp";
const posts = [
  { slug: "how-to-compare-mining-equipment", title: "How to compare mining equipment before requesting a quote", summary: "A buyer-focused checklist for comparing fit, scope, operating conditions and support.", image: chooseImg, alt: "Comparing mining equipment before purchase" },
  { slug: "what-to-prepare-before-equipment-selection", title: "What to prepare before equipment selection", summary: "The practical information that helps a supplier make a more useful first recommendation.", image: prepImg, alt: "Preparing project information for equipment selection" },
  { slug: "export-equipment-delivery-checklist", title: "An export equipment delivery checklist", summary: "Key questions about packing, documents, site readiness and follow-up support.", image: exportImg, alt: "Export equipment delivery checklist" },
];
---
<BaseLayout title="Mining Equipment Blog" description="Read practical articles about mining equipment comparison, project preparation, export delivery and procurement decisions.">
  <PageHero tone="dark" title="Blog" intro="Practical guidance for comparing products, preparing project information and planning delivery." crumbs={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources" }, { label: "Blog" }]} />
  <Section title="Blog" intro="Clear, useful guidance for teams comparing products, preparing project information and planning delivery.">
    <div class="grid gap-7 lg:grid-cols-3">{posts.map((post) => <a href={`/resources/blog/${post.slug}`} class="group card overflow-hidden"><div class="aspect-[4/3] overflow-hidden"><OptimizedImage src={post.image} alt={post.alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" /></div><div class="p-6"><h2 class="!text-xl text-brand-700 underline decoration-transparent underline-offset-4 transition group-hover:decoration-accent-500">{post.title}</h2><p class="mt-3 text-sm leading-relaxed text-carbon-500">{post.summary}</p><span class="mt-5 inline-flex font-700 text-accent-700">Read article →</span></div></a>)}</div>
  </Section>
</BaseLayout>
