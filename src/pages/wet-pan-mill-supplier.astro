---
import BaseLayout from "../layouts/BaseLayout.astro";
import WetPanLandingHeader from "../components/WetPanLandingHeader.astro";
import WetPanLandingFooter from "../components/WetPanLandingFooter.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import Icon from "../components/Icon.astro";
import productImg from "../assets/images/wet-pan-mill-supplier/1200-wet-pan-mill-product.webp";
import thailandImg from "../assets/images/wet-pan-mill-supplier/wet-pan-mill-customer-site-thailand.webp";
import africaImg from "../assets/images/wet-pan-mill-supplier/wet-pan-mill-customer-site-south-africa.webp";

const models = [
  {model:"1100",feed:"<20 mm",capacity:"0.5 t/h",power:"5.5 kW",speed:"11–19 rpm",fit:"Entry-level rock gold grinding"},
  {model:"1200",feed:"<20 mm",capacity:"0.5–1 t/h",power:"7.5 kW",speed:"11–19 rpm",fit:"Common small gold plant choice"},
  {model:"1400",feed:"<20 mm",capacity:"1–1.5 t/h",power:"15 kW",speed:"18–21 rpm",fit:"Higher daily ore volume"},
  {model:"1500",feed:"<30 mm",capacity:"1.5–2 t/h",power:"22 kW",speed:"18–22 rpm",fit:"Medium-scale field operation"},
  {model:"1600",feed:"<30 mm",capacity:"2–3 t/h",power:"30/37 kW",speed:"18–20 rpm",fit:"Highest nominal range here"},
];
const faqs = [
  ["Which wet pan mill model should I buy?","Start with hourly dry-solids throughput, maximum feed size, ore hardness, target grind and available power. The 1200 is common for smaller gold plants, while 1500–1600 models suit higher nominal throughput."],
  ["Can a wet pan mill run with a diesel engine?","A diesel-powered drive can be proposed for sites with unreliable grid power. Confirm altitude, ambient conditions and the preferred engine brand before quotation."],
  ["Does a wet pan mill recover gold by itself?","The mill grinds and mixes ore into slurry. Actual gold recovery depends on liberation, mineralogy and downstream gravity or leaching equipment. No responsible supplier can guarantee recovery from mill model alone."],
  ["What wear parts should be ordered with the machine?","Ask for a recommended startup spares package covering roller surfaces, grinding ring, bearings, belts and seals based on expected operating hours and local maintenance access."],
  ["How is the machine shipped?","The main frame and pan are secured for container transport; motor, reducer and smaller parts are protected separately. Final packing depends on model and destination."],
];
const jsonLd={"@context":"https://schema.org","@graph":[{"@type":"Product",name:"Wet Pan Mill for Gold Ore",description:"Double-wheel wet pan mills in 1100–1600 models for small and medium gold ore grinding plants.",image:`https://miningzd.com${productImg.src}`,brand:{"@type":"Brand",name:"ZD Mining"}},{"@type":"FAQPage",mainEntity:faqs.map(([q,a])=>({"@type":"Question",name:q,acceptedAnswer:{"@type":"Answer",text:a}}))}]};
const quoteAction="openContactModal({ sourcePage: '/wet-pan-mill-supplier/', productInterest: 'Wet Pan Mill', ctaLabel: 'Get Model and Price' })";
---
<BaseLayout chrome={false} title="Wet Pan Mill Supplier for Gold Ore Grinding" description="Source 1100–1600 wet pan mills for gold ore grinding. Compare capacity, power and fit, then request model selection, packing scope and export price." image={productImg.src} jsonLd={jsonLd}>
  <WetPanLandingHeader />
  <section class="relative overflow-hidden bg-[#11110f] text-white">
    <div class="container-x grid min-h-[720px] gap-10 py-16 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-20">
      <div class="relative z-10">
        <p class="max-w-xl text-sm font-700 uppercase tracking-[0.16em] text-accent-300">Wet Pan Mill Supplier · 1100–1600 Models</p>
        <h1 class="mt-5 max-w-3xl !text-[clamp(2.6rem,5.5vw,5.7rem)] !leading-[.98] !tracking-[-.035em] !text-white">Grind more gold ore with the wet pan mill your site can actually run</h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/72">Get a double-wheel wet pan mill matched to your feed size, hourly target and available power—plus the packing, wear parts and technical answers needed to buy with fewer surprises.</p>
        <div class="mt-9 flex flex-wrap gap-3"><button class="btn btn-primary px-7 py-4" onclick={quoteAction}>Get My Model & Export Price <Icon name="arrowRight" class="size-4" /></button><a href="#models" class="btn btn-ghost-light px-7 py-4">Compare Models</a></div>
        <ul class="mt-9 grid gap-3 text-sm text-white/70 sm:grid-cols-3"><li class="border-t border-accent-400 pt-3">0.5–3 t/h nominal range</li><li class="border-t border-accent-400 pt-3">5.5–37 kW options</li><li class="border-t border-accent-400 pt-3">Grid or diesel proposal</li></ul>
      </div>
      <div class="relative bg-white p-6 lg:p-10"><OptimizedImage src={productImg} alt="1200 double-wheel wet pan mill supplied for gold ore grinding" class="aspect-[4/3] w-full object-contain" loading="eager" fetchpriority="high" widths={[480, 720, 1000, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" /><div class="absolute bottom-0 left-0 bg-accent-400 px-5 py-3 text-sm font-800 text-carbon-950">MOST REQUESTED: 1200 MODEL</div></div>
    </div>
  </section>

  <section id="why-wet-pan-mill" class="border-b border-carbon-200 bg-white py-20 lg:py-28"><div class="container-x grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><h2 class="max-w-md !text-4xl">A practical first mill for small gold plants</h2></div><div class="grid gap-px bg-carbon-200 sm:grid-cols-2"><div class="bg-white p-7"><h3>Fits limited power</h3><p class="mt-3 text-carbon-500">Installed power starts at 5.5 kW, with diesel-drive proposals available for off-grid sites.</p></div><div class="bg-white p-7"><h3>Keeps operation simple</h3><p class="mt-3 text-carbon-500">Accessible rollers, pan and drive simplify routine checks and wear-part replacement.</p></div><div class="bg-white p-7"><h3>Grinds and mixes slurry</h3><p class="mt-3 text-carbon-500">Heavy rollers crush, knead and mix ore with water before gravity concentration.</p></div><div class="bg-white p-7"><h3>Scales by model</h3><p class="mt-3 text-carbon-500">Choose from 1100 through 1600 rather than overbuying a mill your feed cannot support.</p></div></div></div></section>

  <section class="bg-carbon-950 py-20 text-white lg:py-28"><div class="container-x"><div class="max-w-3xl"><h2 class="!text-4xl !text-white">The machine is simple. The purchase still needs engineering.</h2><p class="mt-5 text-lg text-white/65">A supplier should ask how the mill fits the full circuit—not promise recovery from a catalogue model.</p></div><div class="mt-12 grid gap-px bg-carbon-700 lg:grid-cols-4">{[["Ore in","Type, hardness and max feed"],["Grinding target","Required fineness and tonnes/hour"],["Site reality","Power, water, altitude and access"],["Scope out","Mill, drive, spares, packing and support"]].map(([t,d])=><div class="bg-carbon-900 p-7"><h3 class="!text-xl !text-accent-300">{t}</h3><p class="mt-3 text-sm text-white/60">{d}</p></div>)}</div></div></section>

  <section id="models" class="bg-brand-50 py-20 lg:py-28"><div class="container-x"><div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"><div><h2 class="!text-4xl">Compare common wet pan mill models</h2><p class="mt-4 max-w-2xl text-carbon-600">Use these ranges for shortlisting only. Capacity changes with ore hardness, feed consistency, water addition and target grind.</p></div><button class="btn btn-brand" onclick={quoteAction}>Confirm a Model for My Ore <Icon name="arrowRight" class="size-4" /></button></div><div class="mt-10 overflow-x-auto border border-brand-200 bg-white"><table class="w-full min-w-[850px] border-collapse text-left"><thead class="bg-carbon-950 text-white"><tr>{["Model","Feed","Nominal capacity","Power","Speed","Best preliminary fit"].map(h=><th class="border-r border-carbon-700 px-5 py-4 text-xs uppercase tracking-wider">{h}</th>)}</tr></thead><tbody>{models.map((m,i)=><tr class={i===1?"bg-accent-300/25":"border-t border-carbon-200"}><td class="px-5 py-5 text-xl font-800 text-brand-700">{m.model}</td><td class="px-5 py-5">{m.feed}</td><td class="px-5 py-5 font-700">{m.capacity}</td><td class="px-5 py-5">{m.power}</td><td class="px-5 py-5">{m.speed}</td><td class="px-5 py-5 text-carbon-500">{m.fit}</td></tr>)}</tbody></table></div><p class="mt-4 text-xs text-carbon-500">Preliminary figures synthesized from public supplier specifications reviewed on 2026-09-07; final values require an approved factory datasheet.</p></div></section>

  <section id="field-use" class="bg-white py-20 lg:py-28"><div class="container-x"><div class="grid gap-12 lg:grid-cols-2 lg:items-end"><div><OptimizedImage src={thailandImg} alt="Multiple wet pan mills operating in a small gold ore processing site" class="aspect-[3/2] w-full object-cover" loading="lazy" widths={[480, 720, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" /></div><div class="pb-2"><h2 class="!text-4xl">See what site conditions do to the buying decision</h2><p class="mt-5 text-lg text-carbon-500">Dust, uneven feeding, water control and limited maintenance access change which motor, reducer, wear parts and startup spares belong in the shipment.</p><ul class="mt-7 space-y-3">{["Request clear installation dimensions before civil work","Confirm crusher discharge stays below the mill feed limit","Order a startup wear-parts package with the first shipment","Ask who provides commissioning guidance and in what format"].map(x=><li class="flex gap-3 border-t border-carbon-200 pt-3"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-accent-600" />{x}</li>)}</ul></div></div><div class="mt-14 grid gap-8 bg-carbon-950 p-8 text-white lg:grid-cols-[1fr_.9fr] lg:p-12"><div><h3 class="!text-3xl !text-white">From standalone mill to working circuit</h3><p class="mt-4 max-w-xl text-white/65">A practical line may include jaw crushing, fine crushing, the wet pan mill, a centrifugal concentrator and shaking tables. Tell us what you already own so the proposal covers only the missing scope.</p><button class="btn btn-primary mt-7" onclick={quoteAction}>Map My Equipment Scope <Icon name="arrowRight" class="size-4" /></button></div><OptimizedImage src={africaImg} alt="Wet pan mill installed at an outdoor gold ore grinding operation" class="aspect-[16/10] w-full object-cover" loading="lazy" widths={[480, 720, 1000]} sizes="(min-width: 1024px) 45vw, 100vw" /></div></div></section>

  <section class="border-y border-carbon-200 bg-carbon-50 py-20 lg:py-28"><div class="container-x"><h2 class="max-w-3xl !text-4xl">What your first quote should make clear</h2><div class="mt-10 grid gap-px bg-carbon-300 md:grid-cols-2 lg:grid-cols-3">{[["Machine scope","Model, motor/reducer, guards and included accessories"],["Performance basis","Feed, nominal capacity and assumptions behind it"],["Wear parts","Included spares and recommended operating stock"],["Packing","Container plan, protection and loose-part list"],["Delivery","Production lead time and Incoterm basis"],["Support","Manuals, installation guidance and response channel"]].map(([t,d])=><div class="bg-white p-7"><h3 class="!text-lg">{t}</h3><p class="mt-3 text-sm text-carbon-500">{d}</p></div>)}</div></div></section>

  <section id="faq" class="bg-white py-20 lg:py-28"><div class="container-x grid gap-12 lg:grid-cols-[.7fr_1.3fr]"><div><h2 class="!text-4xl">Wet pan mill buyer questions</h2><p class="mt-4 text-carbon-500">Straight answers before you request a pro forma invoice.</p></div><div class="divide-y divide-carbon-200 border-y border-carbon-200">{faqs.map(([q,a])=><details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-700 text-brand-800">{q}<span class="text-2xl font-400 text-accent-600">+</span></summary><p class="mt-4 max-w-3xl pr-8 text-carbon-500">{a}</p></details>)}</div></div></section>

  <section class="bg-accent-400 py-20 lg:py-24"><div class="container-x grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end"><div><h2 class="max-w-4xl !text-[clamp(2.4rem,5vw,4.8rem)] !leading-none !text-carbon-950">Send four facts. Get a model shortlist and quotation basis.</h2><p class="mt-6 max-w-2xl text-lg text-carbon-800">Ore type · maximum feed size · tonnes per hour · available power. Add your destination port when you want packing and freight terms included.</p></div><button class="btn !bg-carbon-950 !px-8 !py-5 !text-white hover:!bg-carbon-800" onclick={quoteAction}>Get My Wet Pan Mill Quote <Icon name="arrowRight" class="size-5" /></button></div></section>
  <WetPanLandingFooter />
</BaseLayout>
