---
/**
 * BaseLayout — wraps every page with <head> SEO, fonts, header, footer,
 * and the scroll-reveal controller. Pass per-page frontmatter via props.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ContactModal from "../components/ContactModal.astro";
import { SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** OG image — absolute or root-relative path (1200x630px recommended) */
  image?: string;
  noindex?: boolean;
  /** Optional JSON-LD object injected as structured data */
  jsonLd?: Record<string, any>;
  /** Page type for og:type */
  type?: "website" | "article";
  class?: string;
  chrome?: boolean;
}

const {
  title,
  description = SITE.description,
  image = "/og-default.svg",
  noindex = true,
  jsonLd,
  type = "website",
  class: className = "",
  chrome = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/zd-mining-favicon-white.png" />
    <link rel="preload" href="/fonts/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-slab-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={SITE.locale} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    {/* Additional SEO meta tags */}
    <meta name="author" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />

    <meta name="theme-color" content="#e3a319" />

    {/* Speed up form submission: open connections to Web3Forms and the
        IP lookup endpoint before the visitor submits. */}
    <link rel="preconnect" href="https://api.web3forms.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.ipify.org" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Load analytics after the first render so third-party code cannot compete
        with the hero image, fonts and other LCP resources. The dataLayer is
        still available immediately, so early conversion events are retained. */}
    <script
      is:inline
      set:html={`(function(w,d){var loaded=false;var load=function(){if(loaded)return;loaded=true;var l='dataLayer',i='GTM-N7B74G9D';w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName('script')[0],j=d.createElement('script'),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)};var later=function(){w.setTimeout(load,5000)};if(w.requestIdleCallback){w.requestIdleCallback(later,{timeout:5000})}else{w.addEventListener('load',later,{once:true})}['pointerdown','keydown','touchstart'].forEach(function(type){d.addEventListener(type,load,{once:true,passive:true,capture:true})})})(window,document);`}
    />
    {/* End Google Tag Manager */}
  </head>
  <body class={className}>
    {/* Google Tag Manager (noscript) */}
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-N7B74G9D"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    {/* End Google Tag Manager (noscript) */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-xs focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    {chrome && <Header />}

    <main id="main">
      <slot />
    </main>

    {chrome && <Footer />}
    <ScrollReveal />
    <ContactModal />

    {/* Global WhatsApp click tracking (event delegation — catches every
        wa.me link on any page, present or future). See .claude/rules/WHATSAPP-TRACKING.md */}
    <script is:inline>
      document.addEventListener("click", (e) => {
        const link = (e.target as Element | null)?.closest?.(
          "a[href*='wa.me'], a[href*='api.whatsapp.com']"
        );
        if (link) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "whatsapp_click",
            page_location: window.location.pathname,
            whatsapp_url: link.getAttribute("href"),
          });
        }
      });
    </script>
  </body>
</html>
