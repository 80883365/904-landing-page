---
/**
 * Horizontal stat strip — big condensed numbers + label.
 * Pass an array of { value, label, suffix? }.
 */
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  tone?: "dark" | "light";
  class?: string;
}
const { stats, tone = "dark", class: className = "" } = Astro.props;
const isDark = tone === "dark";
---
<dl class={`grid grid-cols-2 gap-px overflow-hidden rounded-md border ${isDark ? "border-white/15 bg-white/5" : "border-carbon-100 bg-carbon-100"} lg:grid-cols-4 ${className}`.trim()}>
  {stats.map((s) => (
    <div class={`flex flex-col gap-1 p-6 text-center sm:p-8 ${isDark ? "bg-carbon-900" : "bg-white"}`}>
      <dt class={`font-condensed text-3xl font-800 leading-none sm:text-4xl ${isDark ? "text-accent-400" : "text-brand-600"}`}>
        {s.value}
      </dt>
      <dd class={`mt-2 text-sm ${isDark ? "text-white/65" : "text-carbon-500"}`}>{s.label}</dd>
    </div>
  ))}
</dl>
