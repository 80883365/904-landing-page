---
/**
 * Blog card — article preview with image, category, date and reading time.
 * Pass a LOCAL optimized image via `image` (ImageMetadata from an import).
 */
import Icon from "./Icon.astro";
import OptimizedImage from "./OptimizedImage.astro";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  date?: Date | string;
  category?: string;
  readingTime?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  class?: string;
}
const {
  href,
  title,
  excerpt,
  date,
  category,
  readingTime,
  image,
  imageAlt,
  class: className = "",
} = Astro.props;

const fmtDate = date
  ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
  : null;
---
<a
  href={href}
  class={`card card-hover group flex h-full flex-col overflow-hidden ${className}`.trim()}
>
  {/* Media */}
  <div class="relative aspect-[16/9] shrink-0 overflow-hidden">
    {image ? (
      <OptimizedImage
        src={image}
        alt={imageAlt ?? title}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      />
    ) : (
      <div class="h-full w-full bg-gradient-to-br from-brand-700 to-brand-600"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-carbon-950/50 to-transparent"></div>
    {category && (
      <span class="absolute bottom-3 left-3 chip !bg-white/90 !text-brand-600 !border-transparent backdrop-blur">
        {category}
      </span>
    )}
  </div>

  {/* Body */}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="!text-lg !text-brand-600 group-hover:text-accent-600">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-carbon-500 line-clamp-3">{excerpt}</p>
    <div class="mt-4 flex items-center gap-3 text-xs text-carbon-400">
      {fmtDate && <span>{fmtDate}</span>}
      {fmtDate && readingTime && <span aria-hidden="true">•</span>}
      {readingTime && (
        <span class="flex items-center gap-1">
          <Icon name="clock" class="size-3.5" />
          {readingTime}
        </span>
      )}
    </div>
  </div>
</a>
