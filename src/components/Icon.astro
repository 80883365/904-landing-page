 * Usage: <Icon name="check" class="size-5" />
 */
interface Props {
  name: string;
  class?: string;
  stroke?: number;
}
const { name, class: className = "size-5", stroke = 1.75 } = Astro.props;

const paths: Record<string, string> = {
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
