---
import Icon from "./Icon.astro";
---
<header class="sticky top-0 z-50 border-b border-carbon-800 bg-carbon-950 text-white">
  <div class="container-x flex h-16 items-center justify-between gap-5">
    <a href="/wet-pan-mill-supplier/" class="flex items-center gap-3" aria-label="ZD Mining Wet Pan Mill Supplier landing page">
      <span class="flex size-9 items-center justify-center bg-accent-400 text-carbon-950"><Icon name="layers" class="size-5" /></span>
      <span><strong class="block text-base leading-none">ZD Mining</strong><small class="mt-1 hidden text-[0.62rem] font-700 uppercase tracking-[0.17em] text-accent-300 sm:block">Wet Pan Mill Supply</small></span>
    </a>
    <nav class="hidden items-center gap-7 text-sm text-white/70 lg:flex" aria-label="Landing page">
      <a href="#why-wet-pan-mill" class="hover:text-white">Why it fits</a>
      <a href="#models" class="hover:text-white">Models</a>
      <a href="#field-use" class="hover:text-white">Field use</a>
      <a href="#faq" class="hover:text-white">FAQ</a>
    </nav>
    <button class="btn btn-primary !px-3 !py-3 text-xs sm:!px-5 sm:text-sm" onclick="openContactModal({ sourcePage: '/wet-pan-mill-supplier/', productInterest: 'Wet Pan Mill', ctaLabel: 'Get Model and Price' })"><span class="sm:hidden">Get Price</span><span class="hidden sm:inline">Get Model & Price</span> <Icon name="arrowRight" class="size-4" /></button>
  </div>
</header>
