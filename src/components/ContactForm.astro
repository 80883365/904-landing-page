---
/**
 * ContactForm - 询盘表单组件
 * 使用 Web3Forms，仅包含 Name、Email、Phone、Message 四个基础字段
 * 支持 hidden 字段用于追踪来源
 */
import Field from "./Field.astro";
import Icon from "./Icon.astro";
import { SITE } from "../consts";

interface Props {
  /** 来源页面路径（hidden 字段） */
  sourcePage?: string;
  /** 产品兴趣（hidden 字段） */
  productInterest?: string;
  /** 应用场景兴趣（hidden 字段） */
  applicationInterest?: string;
  /** CTA 按钮文案（hidden 字段） */
  ctaLabel?: string;
  /** Allows this form to be rendered inline as well as inside the modal. */
  formId?: string;
  statusId?: string;
  fieldIdPrefix?: string;
  closeModalOnSuccess?: boolean;
}

const {
  sourcePage,
  productInterest,
  applicationInterest,
  ctaLabel,
  formId = "contact-modal-form",
  statusId = "modal-form-status",
  fieldIdPrefix = "",
  closeModalOnSuccess = true,
} = Astro.props;
const fieldId = (name: string) => fieldIdPrefix ? `${fieldIdPrefix}-${name}` : name;
---

<form
  id={formId}
  data-inquiry-form
  data-close-modal={closeModalOnSuccess}
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-5"
>
  {/* Web3Forms config */}
  <input type="hidden" name="access_key" value={SITE.web3formsKey} />
  <input type="hidden" name="subject" value="New inquiry from GoldCore website" />
  <input type="hidden" name="from_name" value="GoldCore Website" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  {/* Hidden tracking fields */}
  {sourcePage && <input type="hidden" name="source_page" value={sourcePage} />}
  {productInterest && <input type="hidden" name="product_interest" value={productInterest} />}
  {applicationInterest && <input type="hidden" name="application_interest" value={applicationInterest} />}
  {ctaLabel && <input type="hidden" name="cta_label" value={ctaLabel} />}

  {/* Form fields */}
  <div class="grid gap-5 sm:grid-cols-2">
    <Field label="Name" name="name" id={fieldId("name")} placeholder="Jane Doe" />
    <Field label="Email *" name="email" id={fieldId("email")} type="email" required placeholder="jane@example.com" />
  </div>

  <Field label="Phone / WhatsApp" name="phone" id={fieldId("phone")} type="tel" placeholder="+1 555 000 0000" />

  <div>
    <label class="mb-1.5 block text-sm font-700 text-carbon-700">Message *</label>
    <textarea
      id={fieldId("message")}
      name="message"
      required
      rows="4"
      placeholder="Tell us about your requirements, application, or questions..."
      class="w-full rounded-xs border border-carbon-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
    ></textarea>
  </div>

  <label class="flex items-start gap-2.5 text-sm text-carbon-500">
    <input type="checkbox" name="consent" required class="mt-0.5 size-4 rounded-xs border-carbon-300 text-accent-500 focus:ring-accent-500" />
    I agree to be contacted about my inquiry and accept the privacy policy.
  </label>

  <button type="submit" class="btn btn-primary w-full text-base">
    Send inquiry <Icon name="arrowRight" class="size-4" />
  </button>

  <p id={statusId} data-form-status class="hidden rounded-xs border p-4 text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  // AJAX submission for modal and inline inquiry forms
  document.querySelectorAll("form[data-inquiry-form]").forEach((formElement) => {
    if ((formElement as HTMLFormElement).dataset.inquiryBound === "true") return;
    (formElement as HTMLFormElement).dataset.inquiryBound = "true";
    const form = formElement as HTMLFormElement;
    const status = form.querySelector("[data-form-status]");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = "Sending…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = await res.json();

        if (data.success) {
          if (status) {
            status.className =
              "block rounded-xs border border-cat-lime/30 bg-cat-lime/10 p-4 text-sm text-brand-700";
            status.innerHTML =
              "✓ Thank you! Your inquiry has been sent. We'll reply within 24 hours.";
          }
          form.reset();

          if (form.dataset.closeModal === "true") {
            setTimeout(() => {
              const modal = document.getElementById("contact-modal");
              if (modal) modal.classList.add("hidden");
            }, 2000);
          }
        } else {
          throw new Error(data.message || "Submission failed");
        }
      } catch (err) {
        if (status) {
          status.className =
            "block rounded-xs border border-cat-red/30 bg-cat-red/10 p-4 text-sm text-cat-red";
          status.innerHTML =
              "Something went wrong. Please try again later or call our sales team.";
        }
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  });
</script>
