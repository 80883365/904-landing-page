# ----------------------------------------------------------------------------
# Environment variables — copy this file to ".env" and fill in your values.
# Variables exposed to the client MUST be prefixed with PUBLIC_.
# ----------------------------------------------------------------------------

# Web3Forms access key (https://web3forms.com → "Access Key")
# Optional here; the form reads from src/consts.ts by default. To drive it from
# the environment instead, set this and reference import.meta.env in consts.ts.
PUBLIC_WEB3FORMS_KEY=your-access-key-here
