---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import BlogCard from "../../components/BlogCard.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
const blogImg = "/images/iodine-number-explained.webp";

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  const categories = [...new Set(allPosts.map((p) => p.data.category))];
  const postsPerPage = 9;
  const totalPages = Math.ceil(allPosts.length / postsPerPage);

  const paths = [];

  // Generate all pages
  for (let i = 1; i <= totalPages; i++) {
    const start = (i - 1) * postsPerPage;
    const posts = allPosts.slice(start, start + postsPerPage);

    paths.push({
      params: { page: i === 1 ? undefined : String(i) },
      props: {
        posts,
        categories,
        allPosts,
        currentPage: i,
        totalPages,
      },
    });
  }

  return paths;
}) satisfies GetStaticPaths;

const { posts, categories, allPosts, currentPage, totalPages } = Astro.props;

const getCategoryUrl = (category: string) => {
  return `/blog/category/${category.toLowerCase().replace(/\s+/g, "-")}`;
};

const getCategoryCount = (category: string) => {
  return allPosts.filter((p: any) => p.data.category === category).length;
};

const getPageUrl = (page: number) => {
  return page === 1 ? "/blog" : `/blog/${page}`;
};

const start = (currentPage - 1) * 9 + 1;
const end = Math.min(currentPage * 9, allPosts.length);
---
<BaseLayout
  title="Blog & Insights"
  description="Practical guidance on selecting, specifying and managing activated carbon 鈥?from CarboPure's technical team."
>
  <PageHero
    tone="dark"
    eyebrow="Insights"
    title="Activated carbon, explained"
    intro="Practical, no-nonsense guidance on choosing, testing and getting more value from your activated carbon."
    crumbs={[{ label: "Home", href: "/" }, { label: "Blog" }]}
  />

  {/* Blog grid */}
  <Section tone="alt">
    {/* Category filter */}
    <div class="mb-8">
      <h3 class="mb-3 text-base font-700 text-carbon-800">Browse by Category</h3>
      <div class="flex flex-wrap gap-2">
        <a
          href="/blog"
          class="chip !bg-accent-600 !text-white !border-accent-600 hover:!bg-accent-700"
        >
          All Articles ({allPosts.length})
        </a>
        {categories.map((c: string) => (
          <a
            href={getCategoryUrl(c)}
            class="chip hover:!bg-carbon-100 hover:!border-carbon-300"
          >
            {c} ({getCategoryCount(c)})
          </a>
        ))}
      </div>
    </div>

    <div class="mb-6">
      <p class="text-sm text-carbon-500">
        Showing {start}-{end} of {allPosts.length} articles
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post: any) => (
        <BlogCard
          href={`/blog/${post.id}`}
          title={post.data.title}
          excerpt={post.data.description}
          date={post.data.pubDate}
          category={post.data.category}
          readingTime="5 min read"
          image={post.data.heroImage || blogImg}
          imageAlt={post.data.title}
        />
      ))}
    </div>

    {/* Pagination */}
    {totalPages > 1 && (
      <div class="mt-12 flex items-center justify-center gap-2">
        {/* Previous button */}
        {currentPage > 1 ? (
          <a
            href={getPageUrl(currentPage - 1)}
            class="flex items-center gap-2 rounded-xs border border-carbon-200 px-4 py-2 text-sm font-700 text-carbon-700 transition hover:bg-carbon-50"
          >
            <Icon name="chevronLeft" class="size-4" />
            Previous
          </a>
        ) : (
          <span class="flex items-center gap-2 rounded-xs border border-carbon-100 px-4 py-2 text-sm font-700 text-carbon-300">
            <Icon name="chevronLeft" class="size-4" />
            Previous
          </span>
        )}

        {/* Page numbers */}
        <div class="flex items-center gap-1">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page: number) => (
            page === currentPage ? (
              <span class="flex size-10 items-center justify-center rounded-xs bg-accent-600 text-sm font-700 text-white">
                {page}
              </span>
            ) : (
              <a
                href={getPageUrl(page)}
                class="flex size-10 items-center justify-center rounded-xs border border-carbon-200 text-sm font-700 text-carbon-700 transition hover:bg-carbon-50"
              >
                {page}
              </a>
            )
          ))}
        </div>

        {/* Next button */}
        {currentPage < totalPages ? (
          <a
            href={getPageUrl(currentPage + 1)}
            class="flex items-center gap-2 rounded-xs border border-carbon-200 px-4 py-2 text-sm font-700 text-carbon-700 transition hover:bg-carbon-50"
          >
            Next
            <Icon name="chevronRight" class="size-4" />
          </a>
        ) : (
          <span class="flex items-center gap-2 rounded-xs border border-carbon-100 px-4 py-2 text-sm font-700 text-carbon-300">
            Next
            <Icon name="chevronRight" class="size-4" />
          </span>
        )}
      </div>
    )}
  </Section>
</BaseLayout>
